{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "AVM development",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AVM_WITH_ARDENS": "ON",
        "AVM_BUILD_TESTS": "ON",
        "AVM_BUILD_BENCHMARKS": "ON",
        "AVM_BUILD_DEBUGGER": "ON",
        "AVM_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "core",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {
        "AVM_WITH_ARDENS": "OFF"
      }
    },
    {
      "name": "headless",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "AVM_BUILD_DEBUGGER": "OFF"
      }
    },
    {
      "name": "fuzz",
      "displayName": "AVM backend fuzzing",
      "description": "Sanitizer and coverage instrumented LLVM with assertions, for tools/fuzz_backend.py. Not part of CI.",
      "inherits": "core",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "LLVM_ENABLE_ASSERTIONS": "ON",
        "LLVM_ENABLE_ZLIB": "OFF",
        "LLVM_USE_SANITIZE_COVERAGE": "ON",
        "LLVM_USE_SANITIZER": "Address;Undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "sdk",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo",
      "targets": [
        "avm_sdk"
      ]
    },
    {
      "name": "check-fast",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo",
      "targets": [
        "avm_validation_fast"
      ]
    },
    {
      "name": "check-full",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo",
      "targets": [
        "avm_validation_full"
      ]
    },
    {
      "name": "bench",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo",
      "targets": [
        "avm_bench_run"
      ]
    },
    {
      "name": "fuzz-tools",
      "configurePreset": "fuzz",
      "configuration": "RelWithDebInfo",
      "targets": [
        "llvm-isel-fuzzer",
        "llvm-reduce",
        "llc",
        "llvm-as",
        "llvm-dis"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "fast",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo",
      "filter": {
        "include": {
          "label": "^fast$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "full",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo",
      "filter": {
        "include": {
          "label": "^full$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
