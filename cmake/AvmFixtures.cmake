include_guard(GLOBAL)

# A fixture has one source identity, one build recipe and one runner entry.
# Verifier-only images participate in the build but are never serial-output tests.
function(avm_fixture source)
    cmake_parse_arguments(F "EXPECT_PASS;VERIFY_ONLY;RUNTIME"
        "KIND;SUITE;EXPECTED;STARTUP;CXX_INCLUDE;CXX_LINKAGE"
        "OPT_LEVELS;COMPILE_OPTIONS;SUPPORT_SOURCES;SUPPORT_OPTIONS;LINK_OPTIONS;O0_OPTIONS;O1_OPTIONS;O2_OPTIONS;O3_OPTIONS;Os_OPTIONS;Oz_OPTIONS"
        ${ARGN})
    if(F_UNPARSED_ARGUMENTS OR NOT F_KIND OR NOT F_SUITE)
        message(FATAL_ERROR "Invalid fixture declaration: ${source}: ${F_UNPARSED_ARGUMENTS}")
    endif()
    get_filename_component(name "${source}" NAME_WE)
    get_property(registered GLOBAL PROPERTY "AVM_FIXTURE_${F_KIND}_${name}" SET)
    if(registered)
        message(FATAL_ERROR "Duplicate ${F_KIND} fixture name: ${name}")
    endif()
    if(F_OPT_LEVELS STREQUAL "ALL")
        set(F_OPT_LEVELS ${AVM_TEST_OPT_LEVELS})
    endif()
    set(source "${PROJECT_SOURCE_DIR}/tests/${source}")
    if(F_CXX_INCLUDE)
        set(body "#include \"${PROJECT_SOURCE_DIR}/tests/${F_CXX_INCLUDE}\"\n")
        if(F_CXX_LINKAGE STREQUAL "DECLARE")
            string(PREPEND body "extern \"C\" int avm_test_main(void);\n")
        elseif(F_CXX_LINKAGE STREQUAL "BLOCK")
            set(body "extern \"C\" {\n${body}}\n")
        endif()
        set(source "${PROJECT_BINARY_DIR}/tests/sources/${name}.cpp")
        file(GENERATE OUTPUT "${source}" CONTENT "${body}")
    endif()
    set_property(GLOBAL PROPERTY "AVM_FIXTURE_${F_KIND}_${name}" "${source}")
    set_property(GLOBAL PROPERTY "AVM_FIXTURE_SUPPORT_${F_KIND}_${name}" "${F_SUPPORT_SOURCES}")
    set("AVM_FIXTURE_${F_KIND}_${name}" "${source}" PARENT_SCOPE)
    if(F_KIND STREQUAL "ASM")
        set(binary_dir "${AVM_ASM_TEST_BINARY_DIR}")
        set(variants ASM)
        set(include_dirs "${AVM_ASM_TEST_DIR}")
    else()
        if(F_KIND STREQUAL "C")
            set(binary_dir "${AVM_C_TEST_BINARY_DIR}")
        else()
            set(binary_dir "${AVM_CXX_TEST_BINARY_DIR}")
        endif()
        set(variants ${F_OPT_LEVELS})
        set(include_dirs)
    endif()
    set(dependencies avm_sysroot)
    if(F_KIND STREQUAL "ASM")
        list(APPEND dependencies ${AVM_ASM_TEST_SUPPORT_SOURCES})
    endif()
    foreach(variant IN LISTS variants)
        set(options ${F_COMPILE_OPTIONS} ${F_${variant}_OPTIONS})
        set(output_dir "${binary_dir}")
        if(NOT variant STREQUAL "ASM")
            string(APPEND output_dir "/${variant}")
            list(PREPEND options "-${variant}")
        endif()
        set(object "${output_dir}/${name}.o")
        avm_add_object(OUTPUT "${object}" SOURCE "${source}" LANGUAGE ${F_KIND}
            INCLUDE_DIRS ${include_dirs} COMPILE_OPTIONS ${options}
            DEPENDS ${dependencies})
        set(objects "${object}")
        foreach(support IN LISTS F_SUPPORT_SOURCES)
            get_filename_component(stem "${support}" NAME_WE)
            set(support_object "${output_dir}/${name}_${stem}.o")
            set(support_options ${options})
            if(DEFINED F_SUPPORT_OPTIONS)
                set(support_options "-${variant}" ${F_SUPPORT_OPTIONS})
            endif()
            avm_add_object(OUTPUT "${support_object}"
                SOURCE "${PROJECT_SOURCE_DIR}/tests/${support}" LANGUAGE ${F_KIND}
                COMPILE_OPTIONS ${support_options} DEPENDS avm_sysroot)
            list(APPEND objects "${support_object}")
        endforeach()
        set(image_args)
        if(NOT F_KIND STREQUAL "ASM" OR F_RUNTIME)
            list(APPEND image_args LIBRARIES
                "${AVM_SYSROOT_DIR}/lib/libavm.a"
                "${AVM_SYSROOT_DIR}/lib/libavm-builtins.a" GC_SECTIONS)
        endif()
        if(NOT F_STARTUP)
            set(F_STARTUP crt0_test.o)
        endif()
        if(NOT F_STARTUP STREQUAL "none")
            list(APPEND image_args STARTUP "${AVM_SYSROOT_DIR}/lib/${F_STARTUP}")
        endif()
        set(image "${output_dir}/${name}.bin")
        avm_add_image(OBJECTS ${objects} OUTPUT_ELF "${output_dir}/${name}.elf"
            OUTPUT_IMAGE "${image}" ENTRY _start LINK_OPTIONS ${F_LINK_OPTIONS}
            ${image_args} DEPENDS avm_sysroot)
        set_property(GLOBAL APPEND PROPERTY "AVM_FIXTURE_IMAGES_${F_SUITE}" "${image}")
        if(name MATCHES "^math_")
            set_property(GLOBAL APPEND PROPERTY AVM_MATH_FULL_IMAGES "${image}")
            if(variant MATCHES "^(O0|O2)$")
                set_property(GLOBAL APPEND PROPERTY AVM_MATH_FAST_IMAGES "${image}")
            endif()
        endif()
    endforeach()
    if(F_EXPECT_PASS)
        set(expected "@PASS")
    elseif(F_EXPECTED)
        set(expected "${PROJECT_SOURCE_DIR}/tests/${F_EXPECTED}")
    elseif(NOT F_VERIFY_ONLY)
        message(FATAL_ERROR "Fixture ${name} needs EXPECT_PASS, EXPECTED or VERIFY_ONLY")
    endif()
    if(NOT F_VERIFY_ONLY)
        string(JOIN "," opts ${variants})
        set_property(GLOBAL APPEND_STRING PROPERTY AVM_FIXTURE_MANIFEST
            "${F_KIND}\t${opts}\t${source}\t${expected}\t${F_SUITE}\n")
    endif()
endfunction()

# Extra LTO images reuse the registered translation units; there is no second
# filename-to-support-source table to maintain.
function(avm_fixture_variant name)
    cmake_parse_arguments(V "" "DIRECTORY;OUTPUT_PREFIX" "COMPILE_OPTIONS" ${ARGN})
    get_property(source GLOBAL PROPERTY "AVM_FIXTURE_CXX_${name}")
    get_property(support GLOBAL PROPERTY "AVM_FIXTURE_SUPPORT_CXX_${name}")
    if(NOT source OR NOT V_DIRECTORY OR NOT V_OUTPUT_PREFIX OR V_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Invalid fixture variant: ${name}")
    endif()
    set(objects)
    foreach(unit IN ITEMS "${source}" ${support})
        if(NOT IS_ABSOLUTE "${unit}")
            set(unit "${PROJECT_SOURCE_DIR}/tests/${unit}")
        endif()
        if(unit STREQUAL source)
            set(object "${V_DIRECTORY}/${name}.o")
        else()
            get_filename_component(stem "${unit}" NAME_WE)
            set(object "${V_DIRECTORY}/${name}_${stem}.o")
        endif()
        avm_add_object(OUTPUT "${object}" SOURCE "${unit}" LANGUAGE CXX
            COMPILE_OPTIONS -O2 ${V_COMPILE_OPTIONS} DEPENDS avm_sysroot)
        list(APPEND objects "${object}")
    endforeach()
    set(elf "${V_DIRECTORY}/${name}.elf")
    set(image "${V_DIRECTORY}/${name}.bin")
    avm_add_image(OBJECTS ${objects} OUTPUT_ELF "${elf}" OUTPUT_IMAGE "${image}"
        ENTRY _start STARTUP "${AVM_SYSROOT_DIR}/lib/crt0_test.o"
        LIBRARIES "${AVM_SYSROOT_DIR}/lib/libavm.a" "${AVM_SYSROOT_DIR}/lib/libavm-builtins.a"
        GC_SECTIONS DEPENDS avm_sysroot)
    set(${V_OUTPUT_PREFIX}_ELF "${elf}" PARENT_SCOPE)
    set(${V_OUTPUT_PREFIX}_IMAGE "${image}" PARENT_SCOPE)
endfunction()
