include_guard(GLOBAL)

# Expand a verifier's case table without repeating its tool and common flags.
function(avm_check_cases output)
    set(common)
    set(current)
    set(commands)
    set(mode COMMON)
    foreach(arg IN LISTS ARGN)
        if(arg STREQUAL "CASE")
            if(mode STREQUAL "CASE")
                list(APPEND commands COMMAND ${common} ${current})
            endif()
            set(current)
            set(mode CASE)
        elseif(mode STREQUAL "COMMON")
            list(APPEND common "${arg}")
        else()
            list(APPEND current "${arg}")
        endif()
    endforeach()
    if(mode STREQUAL "CASE")
        list(APPEND commands COMMAND ${common} ${current})
    endif()
    set(${output} ${commands} PARENT_SCOPE)
endfunction()

# Preserve direct build-and-run targets, and expose their commands separately
# to CTest so validation builds its prerequisites once before execution.
function(avm_add_check name)
    add_custom_target(${name} ${ARGN})
    set_property(GLOBAL APPEND PROPERTY AVM_CHECKS "${name}")
    set_property(TARGET ${name} PROPERTY AVM_CHECK_ARGUMENTS "${ARGN}")
endfunction()

function(avm_finalize_testing)
    include("${PROJECT_SOURCE_DIR}/tests/cmake/Profiles.cmake")
    get_property(checks GLOBAL PROPERTY AVM_CHECKS)
    set(fast_build_targets)
    set(full_build_targets)
    set(extended_build_targets)
    foreach(check IN LISTS checks)
        get_property(args TARGET ${check} PROPERTY AVM_CHECK_ARGUMENTS)
        set(mode "")
        set(script "")
        set(command)
        set(dependencies)
        set(directory "${PROJECT_SOURCE_DIR}")
        # Commands retain their original argument boundaries, including spaces.
        foreach(arg IN LISTS args)
            if(arg MATCHES "^(COMMAND|DEPENDS|COMMENT|WORKING_DIRECTORY|USES_TERMINAL|VERBATIM)$")
                if(mode STREQUAL "COMMAND" AND command)
                    string(APPEND script "execute_process(COMMAND ${command} WORKING_DIRECTORY [==[${directory}]==] COMMAND_ERROR_IS_FATAL ANY)\n")
                    set(command)
                endif()
                set(mode "${arg}")
            elseif(mode STREQUAL "COMMAND")
                string(APPEND command " [==[${arg}]==]")
            elseif(mode STREQUAL "DEPENDS")
                list(APPEND dependencies "${arg}")
            elseif(mode STREQUAL "WORKING_DIRECTORY")
                set(directory "${arg}")
            endif()
        endforeach()
        if(mode STREQUAL "COMMAND" AND command)
            string(APPEND script "execute_process(COMMAND ${command} WORKING_DIRECTORY [==[${directory}]==] COMMAND_ERROR_IS_FATAL ANY)\n")
        endif()
        # add_dependencies calls are part of the same prerequisite contract.
        get_property(extra TARGET ${check} PROPERTY MANUALLY_ADDED_DEPENDENCIES)
        list(APPEND dependencies ${extra})
        set(build_deps)
        foreach(dep IN LISTS dependencies)
            if(dep IN_LIST checks)
                list(APPEND build_deps "${dep}_build")
            else()
                list(APPEND build_deps "${dep}")
            endif()
        endforeach()
        add_custom_target(${check}_build DEPENDS ${build_deps})
        set(path "${PROJECT_BINARY_DIR}/validation/$<CONFIG>/${check}.cmake")
        file(GENERATE OUTPUT "${path}" CONTENT "${script}")
        if(NOT script)
            continue()
        endif()
        add_test(NAME ${check} COMMAND "${CMAKE_COMMAND}" -P "${path}")
        set(labels full)
        if(check IN_LIST AVM_FAST_CHECKS)
            list(APPEND labels fast)
        endif()
        if(check STREQUAL "avm_core_fast_run")
            set(labels fast)
        endif()
        if(check IN_LIST AVM_EXTENDED_CHECKS)
            set(labels extended)
        endif()
        set_tests_properties(${check} PROPERTIES LABELS "${labels}")
        foreach(label IN LISTS labels)
            list(APPEND ${label}_build_targets ${check}_build)
        endforeach()
    endforeach()
    foreach(profile fast full extended)
        add_custom_target(avm_validation_${profile}_build DEPENDS ${${profile}_build_targets})
        add_custom_target(avm_validation_${profile}
            COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${PROJECT_BINARY_DIR}"
                -C RelWithDebInfo --output-on-failure -L "^${profile}$"
            DEPENDS avm_validation_${profile}_build USES_TERMINAL VERBATIM)
    endforeach()
    add_custom_target(avm_validation_build DEPENDS avm_validation_full_build)
    # Every registered check, including the fast-only and extended-only ones.
    add_custom_target(avm_validation_all
        COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${PROJECT_BINARY_DIR}"
            -C RelWithDebInfo --output-on-failure
        DEPENDS avm_validation_fast_build avm_validation_full_build
            avm_validation_extended_build USES_TERMINAL VERBATIM)
endfunction()
