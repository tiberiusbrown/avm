cmake_minimum_required(VERSION 3.20)
include("${AVM_HEADER_PLAN}")
set(manifest "${AVM_INCLUDE_DIR}/.avm-headers")
set(previous)
if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" previous)
endif()
foreach(relative IN LISTS previous)
    if(NOT relative IN_LIST AVM_HEADER_DESTINATIONS)
        file(REMOVE "${AVM_INCLUDE_DIR}/${relative}")
    endif()
endforeach()
list(LENGTH AVM_HEADER_SOURCES count)
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        list(GET AVM_HEADER_SOURCES ${index} source)
        list(GET AVM_HEADER_DESTINATIONS ${index} relative)
        # COPYONLY changes the destination only when its contents change.
        configure_file("${source}" "${AVM_INCLUDE_DIR}/${relative}" COPYONLY)
    endforeach()
endif()
string(JOIN "\n" contents ${AVM_HEADER_DESTINATIONS})
file(WRITE "${manifest}" "${contents}\n")
