// Generated by midi_to_avms.py; physical voices: 0 lead, 1 harmony, 2 bass, 3 noise.
title "Arranger example - drums"
tempo 120
meter 4/4
automation 16ms
loop
// Explicit absolute-boundary timings preserve the source tempo map.

envelope melody_env { points 0ms:100%, 64ms:88% release 8ms:0% curve linear }
instrument melody { wave pulse duty 64 volume 11 envelope melody_env }

envelope harmony_env { points 0ms:100%, 96ms:70% release 8ms:0% curve linear }
instrument harmony { wave pulse duty 32 volume 4 envelope harmony_env }

envelope bass_env { points 0ms:100%, 80ms:82% release 8ms:0% curve linear }
instrument bass { wave pulse duty 128 volume 7 envelope bass_env }

envelope snare_env { points 0ms:100%, 60ms:30% curve linear }
instrument snare { wave noise duty 128 volume 6 envelope snare_env }

envelope open_hat_env { points 0ms:100%, 84ms:30% curve linear }
instrument open_hat { wave noise duty 128 volume 2 envelope open_hat_env }

envelope cymbal_env { points 0ms:100%, 132ms:30% curve linear }
instrument cymbal { wave noise duty 128 volume 3 envelope cymbal_env }

envelope tom_env { points 0ms:100%, 52ms:30% curve linear }
instrument tom { wave noise duty 128 volume 5 envelope tom_env }

// melody; 32 monophonic notes.
channel 0 {
    use melody volume 7 octave 5 gate 408/416 c:416ms
    r:84ms
    use melody volume 7 octave 5 gate 408/416 e:416ms
