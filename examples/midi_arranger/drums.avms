// percussion; 4 monophonic notes.
channel 3 {
    use snare volume 4 octave 4 noise_retrigger { every 64ms seed 23 } g:1000ms
    use cymbal volume 2 octave 6 note_cut { after 220ms } noise_retrigger { every 48ms seed 37 } g:220ms
    r:280ms
    use tom volume 3 octave 3 note_cut { after 84ms } e:84ms
    r:168ms
    use open_hat volume 1 octave 6 note_cut { after 140ms } d:140ms
    r:14024ms
}
