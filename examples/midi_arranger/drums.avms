// harmony; 8 monophonic notes.
channel 1 {
    use harmony volume 2 octave 3 arpeggio { offsets 0,5,9 step 80ms repeat } gate 1868/1876 g:1876ms
    r:124ms
    use harmony volume 2 octave 3 arpeggio { offsets 0,3,8 step 80ms repeat } gate 1868/1876 a:1876ms
