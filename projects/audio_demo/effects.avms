// Offline effects showcase. Compile as music, or keep only channels 1/3 and add sfx.
tempo 120
automation 8ms
envelope soft { points 0ms:0%, 8ms:100%, 120ms:60% release 24ms:0% }
effect shimmer { lfo { target pitch depth 25cents period 160ms } }
instrument lead {
    wave pulse duty 25% volume 16 envelope soft effects shimmer
    duty_slide { from 25% to 12.5% over 180ms }
    lfo { target duty depth 4% period 240ms wave triangle phase song }
}
instrument chord {
    duty 12.5% volume 10
    arpeggio { offsets 0,4,7 step 40ms repeat }
    tremolo { depth 25% period 160ms wave triangle }
    note_cut { after 360ms }
}
instrument bass {
    duty 50% volume 12
    frequency_slide { delta -100cents over 120ms }
    volume_slide { to 0 over 400ms }
}
instrument drum {
    wave noise volume 8 envelope soft
    noise_retrigger { every 16ms seed 37 }
    note_cut { after 120ms }
}
channel 0 lead { c2 ~ c4 r4 }
channel 1 chord {
    c4 arpeggio off note_cut off
    glissando { direction down every 32ms to g3 } c4
    glissando off frequency_slide { to c3 over 240ms curve log } c4 r4
}
channel 2 bass octave 2 { c2 g2 }
channel 3 drum { repeat 4 { c8 r8 } }
