title "Sunlit Garden"
tempo 1250/13
meter 4/4

// Reusable stepped contours preserve the original note articulation.
envelope melody_env { points 0ms:1, 156ms:9/14 curve step }
instrument melody { lfo { target pitch depth 12cents period 240ms wave sine phase note } wave pulse duty 25% volume 14 envelope melody_env gate 5/6 }
envelope melody2_env { points 0ms:1, 156ms:9/13 curve step }
instrument melody2 { lfo { target pitch depth 12cents period 240ms wave sine phase note } wave pulse duty 25% volume 13 envelope melody2_env gate 5/6 }
envelope melody3_env { points 0ms:1, 312ms:9/13 curve step }
instrument melody3 { lfo { target duty depth 6.25% period 320ms wave triangle phase note } lfo { target pitch depth 12cents period 240ms wave sine phase note } wave pulse duty 25% volume 13 envelope melody3_env gate 11/12 }
envelope melody4_env { points 0ms:1, 312ms:9/14 curve step }
instrument melody4 { lfo { target pitch depth 12cents period 240ms wave sine phase note } wave pulse duty 25% volume 14 envelope melody4_env gate 11/12 }
envelope melody5_env { points 0ms:1, 156ms:9/13 curve step }
instrument melody5 { lfo { target pitch depth 12cents period 240ms wave sine phase note } wave pulse duty 25% volume 13 envelope melody5_env gate 5/12 }

envelope bass_env { points 0ms:1, 312ms:7/9, 624ms:5/9 curve step }
instrument bass { wave triangle duty 50% volume 9 envelope bass_env gate 3/4 }

envelope arpeggio_env { points 0ms:1, 156ms:1/2 curve step }
instrument arpeggio { wave pulse duty 12.5% volume 6 envelope arpeggio_env gate 5/6 }

envelope percussion_env { points 0ms:1, 52ms:1/2 curve step }
instrument percussion { wave noise volume 2 envelope percussion_env gate 1/3 }
envelope percussion2_env { points 0ms:1, 52ms:5/9, 156ms:2/9 curve step }
instrument percussion2 { wave noise volume 9 envelope percussion2_env gate 2/3 }
envelope percussion3_env { points 0ms:1, 52ms:1/2, 104ms:1/6 curve step }
instrument percussion3 { wave noise volume 6 envelope percussion3_env gate 1/2 }
envelope percussion4_env { points 0ms:1, 52ms:1/2 curve step }
instrument percussion4 { wave noise volume 2 envelope percussion4_env gate 2/3 }
envelope percussion5_env { points 0ms:1, 52ms:1/4 curve step }
instrument percussion5 { wave noise volume 4 envelope percussion5_env gate 2/3 }

