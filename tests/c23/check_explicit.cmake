file(READ "${INPUT}" ir)
string(FIND "${ir}" "@avm_clear_dead_buffer(" start)
if(start EQUAL -1)
    message(FATAL_ERROR "Missing explicit-clearing probe")
endif()
string(SUBSTRING "${ir}" ${start} -1 body)
string(FIND "${body}" "\n}" end)
string(SUBSTRING "${body}" 0 ${end} body)
string(FIND "${body}" "~{memory}" memory_clobber)
if(NOT body MATCHES "asm sideeffect" OR memory_clobber EQUAL -1)
    message(FATAL_ERROR "Optimized explicit clearing lost its volatile assembly memory barrier")
endif()
if(NOT body MATCHES "memset")
    message(FATAL_ERROR "Optimized explicit clearing of dead storage lost its memory fill")
endif()
