function(check_trig_instruction object symbol instruction)
    execute_process(
        COMMAND "${AVM_OBJDUMP}" -d -r --no-show-raw-insn
            "--disassemble-symbols=${symbol}"
            "${AVM_OBJECT_DIR}/math_${object}.o"
        RESULT_VARIABLE result OUTPUT_VARIABLE code ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${symbol}: ${error}")
    endif()
    if(NOT code MATCHES "[ \t]${instruction}([ \t\r\n]|$)")
        message(FATAL_ERROR "${symbol} must use native ${instruction}: ${code}")
    endif()
    if(instruction STREQUAL "frempio2")
        string(REGEX MATCHALL "[ \t]frempio2([ \t\r\n]|$)" reductions "${code}")
        list(LENGTH reductions count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "${symbol} must contain exactly one FREMPIO2")
        endif()
        string(FIND "${code}" "frempio2" reducer)
        string(SUBSTRING "${code}" 0 ${reducer} prefix)
        if(prefix MATCHES "[ \t](br[a-z0-9]+|jmp[a-z0-9]*|call[a-z0-9]*)[ \t]")
            message(FATAL_ERROR "${symbol} must reduce before branching or calling: ${prefix}")
        endif()
        if(code MATCHES "R_AVM[^\r\n]*(rem_pio2|small_pio2|avm_(sin|cos|tan)_reduced)")
            message(FATAL_ERROR "${symbol} must not call a guest argument reducer")
        endif()
    endif()
    if(code MATCHES "R_AVM[^\r\n]*fmaf")
        message(FATAL_ERROR "${symbol} must inline FMA rather than call fmaf")
    endif()
endfunction()

check_trig_instruction(sf_sin sinf frempio2)
check_trig_instruction(sf_cos cosf frempio2)
check_trig_instruction(sf_tan tanf frempio2)
check_trig_instruction(sf_sincos sincosf frempio2)
check_trig_instruction(sf_tan tanf fma)
check_trig_instruction(kf_tan __kernel_tanf fma)
check_trig_instruction(kf_rem_pio2 avm_rem_pio2f_medium fma)
message(STATUS "Public trig functions reduce unconditionally with one FREMPIO2; tangent/medium reconstruction inline FMA")
